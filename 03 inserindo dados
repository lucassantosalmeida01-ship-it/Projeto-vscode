-- Atividade 02 inserir mais 5 registros de médico (código completo) igual exemplo
create table if not exists consulta (
	id int primary key auto_increment,
    data_time datetime,
    id_paciente int,
    id_medico int,
    foreign key (id_paciente) references paciente(id),
    foreign key (id_medico) references medico(id)
) character set utf8mb4;
insert into consulta
( data_time, id_paciente, id_medico)
values
('2026-09-03 10:10:55', 4, 1),
('2026-09-05 12:08:00', 1, 1);
select*from consulta; 
select consulta.id, consulta.date_time, paciente.nome, medico.nome
from consulta
inner join paciente on consulta.id_paciente = paciente.id
inner join  medico on consulta.id_medico = medico.id;


